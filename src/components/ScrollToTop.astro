---
---
<button 
    class="fixed bottom-6 right-6 sm:bottom-8 sm:right-8 w-11 h-11 rounded-xl bg-[var(--accent-primary)] text-neutral-950 border-none cursor-pointer z-50 flex items-center justify-center opacity-0 invisible translate-y-3 transition-all duration-200 hover:bg-[var(--accent-hover)] hover:-translate-y-0.5 hover:shadow-lg [&.visible]:opacity-100 [&.visible]:visible [&.visible]:translate-y-0" 
    id="scrollTopBtn" 
    aria-label="Scroll to top"
>
    <span class="inline-flex w-4.5 h-4.5">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="19" x2="12" y2="5"></line>
            <polyline points="5 12 12 5 19 12"></polyline>
        </svg>
    </span>
</button>

<script>
    const scrollTopBtn = document.getElementById('scrollTopBtn');
    
    if (scrollTopBtn) {
        window.addEventListener('scroll', () => {
            if (window.scrollY > 500) {
                scrollTopBtn.classList.add('visible');
            } else {
                scrollTopBtn.classList.remove('visible');
            }
        });

        scrollTopBtn.addEventListener('click', () => {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });
    }
</script>
