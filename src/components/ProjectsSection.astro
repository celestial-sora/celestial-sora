---
const projects = [
    { number: '01', type: 'AI VISUAL NOVEL', title: 'Sora Novel', description: 'Visual Novel แนว office life ที่ใช้ AI Memory และ Dynamic Storytelling ทำให้แต่ละ run มีเรื่องราวไม่เหมือนกัน', tags: ['Gemini', 'AI Memory', 'Dynamic Storytelling'], primary: 'ลองเล่นโปรเจกต์', href: 'https://sora-novel.vercel.app/', accent: 'project-banner--pink' },
    { number: '02', type: 'AI COMPANION', title: 'Vivian', description: 'AI companion ภาษาไทยที่มี Live2D character, speech bubble และระบบความจำสำหรับบทสนทนา', tags: ['Live2D', 'Memory', 'TTS / STT'], primary: 'ดูโปรเจกต์', href: 'https://github.com/celestial-sora/ai-waifu', accent: 'project-banner--cyan' },
];
---
<section class="section-shell projects-section" id="projects">
    <div class="section-heading section-heading--row"><div><span class="eyebrow">Selected work</span><h2>Things I make<br /><em>when curiosity wins.</em></h2></div><p>โปรเจกต์บางส่วนที่สะท้อนความสนใจด้าน AI, story และ interface design</p></div>
    <div class="project-grid">
        {projects.map((project) => (
            <article class="project-card material-card">
                <div class={`project-banner ${project.accent}`}><span class="project-banner__index">{project.number} / PROJECT</span><svg class="project-banner__mark" viewBox="0 0 16 16" aria-hidden="true"><path d="m8 1 1.2 5.8L15 8l-5.8 1.2L8 15 6.8 9.2 1 8l5.8-1.2L8 1Z" /></svg><strong>{project.title}</strong></div>
                <div class="project-card__body"><span class="card-kicker">{project.type}</span><h3>{project.title}</h3><p>{project.description}</p><div class="tag-list">{project.tags.map((tag) => <span>{tag}</span>)}</div><a class="button button--primary" href={project.href} target="_blank" rel="noopener noreferrer">{project.primary} <svg class="icon-inline" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 13 13 3M5 3h8v8" /></svg></a></div>
            </article>
        ))}
    </div>
</section>
