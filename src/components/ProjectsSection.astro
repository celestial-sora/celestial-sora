</section>

<script>
    document.addEventListener('DOMContentLoaded', () => {
      requestAnimationFrame(() => {
        const canvas = document.getElementById('githubScratchCanvas') as HTMLCanvasElement | null;
        const wrapper = document.getElementById('githubScratchWrapper');

        if (!canvas || !wrapper) return;

        const ctx = canvas.getContext('2d', { willReadFrequently: true });
        if (!ctx) return;

        let rect = wrapper.getBoundingClientRect();
        let w = (canvas.width = rect.width || 320);
        let h = (canvas.height = rect.height || 46);

        let isRevealed = false;

        const drawFoilCover = () => {
            if (isRevealed) return;
            ctx.globalCompositeOperation = 'source-over';

            const grad = ctx.createLinearGradient(0, 0, w, h);
            grad.addColorStop(0.0, '#3a3848');
            grad.addColorStop(0.4, '#545068');
            grad.addColorStop(0.7, '#3a3848');
            grad.addColorStop(1.0, '#262432');

            ctx.fillStyle = grad;
            ctx.beginPath();
            ctx.roundRect(0, 0, w, h, 12);
            ctx.fill();

            // Metallic glitter noise
            for (let i = 0; i < 180; i++) {
                ctx.fillStyle = Math.random() > 0.5 ? 'rgba(255,255,255,0.22)' : 'rgba(195,177,225,0.2)';
                ctx.fillRect(Math.random() * w, Math.random() * h, 2, 2);
            }

            // Outer border line
            ctx.strokeStyle = 'rgba(255, 255, 255, 0.18)';
            ctx.lineWidth = 1.5;
            ctx.strokeRect(1, 1, w - 2, h - 2);

            const fontSize = w < 340 ? '12px' : '13.5px';

            ctx.fillStyle = '#ffffff';
            ctx.font = `600 ${fontSize} "IBM Plex Mono", sans-serif`;
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.shadowColor = 'rgba(0,0,0,0.6)';
            ctx.shadowBlur = 3;
            ctx.fillText('มาส่องโค้ด / project กันได้น้าา  ➔', w / 2, h / 2);
        };

        drawFoilCover();

        const updateCanvasDimensions = () => {
            if (isRevealed) return;
            rect = wrapper.getBoundingClientRect();
            if (rect.width && rect.height) {
                w = canvas.width = rect.width;
                h = canvas.height = rect.height;
                drawFoilCover();
            }
        };

        window.addEventListener('resize', updateCanvasDimensions, { passive: true });

        const scratchAt = (x: number, y: number) => {
            if (isRevealed) return;

            ctx.globalCompositeOperation = 'destination-out';
            ctx.beginPath();
            ctx.arc(x, y, 22, 0, Math.PI * 2);
            ctx.fill();

            checkRevealed();
        };

        const getCanvasCoords = (e: MouseEvent | TouchEvent) => {
            const r = canvas.getBoundingClientRect();
            let clientX: number, clientY: number;
            if ('touches' in e && e.touches.length > 0) {
                clientX = e.touches[0].clientX;
                clientY = e.touches[0].clientY;
            } else if ('changedTouches' in e && e.changedTouches.length > 0) {
                clientX = e.changedTouches[0].clientX;
                clientY = e.changedTouches[0].clientY;
            } else {
                clientX = (e as MouseEvent).clientX;
                clientY = (e as MouseEvent).clientY;
            }
            return { x: clientX - r.left, y: clientY - r.top };
        };

        const checkRevealed = () => {
            if (isRevealed) return;

            const imgData = ctx.getImageData(0, 0, w, h);
            const pixels = imgData.data;
            let clearCount = 0;

            for (let i = 3; i < pixels.length; i += 16) {
                if (pixels[i] === 0) clearCount++;
            }

            const percent = (clearCount / (pixels.length / 16)) * 100;

            if (percent > 78) {
                isRevealed = true;
                canvas.style.opacity = '0';
                setTimeout(() => {
                    canvas.style.display = 'none';
                }, 400);
            }
        };

        canvas.addEventListener('mousemove', (e) => {
            const pos = getCanvasCoords(e);
            scratchAt(pos.x, pos.y);
        });

        canvas.addEventListener('mouseenter', (e) => {
            const pos = getCanvasCoords(e);
            scratchAt(pos.x, pos.y);
        });

        canvas.addEventListener('touchstart', (e) => {
            const pos = getCanvasCoords(e);
            scratchAt(pos.x, pos.y);
        }, { passive: true });

        canvas.addEventListener('touchmove', (e) => {
            const pos = getCanvasCoords(e);
            scratchAt(pos.x, pos.y);
        }, { passive: true });

        canvas.addEventListener('click', (e) => {
            const pos = getCanvasCoords(e);
            scratchAt(pos.x, pos.y);
            window.open('https://github.com/celestial-sora', '_blank');
        });
      });
    });
</script>

<script>
    // ── Vivian Status Typewriter ─────────────────────────────────────────
    const aiWaifuCard = document.getElementById('aiWaifuCard');
    const vivianStatusText = document.getElementById('vivianStatusText');

    if (aiWaifuCard && vivianStatusText) {
        const statuses = [
            "Vivian is online",
            "Scanning neural core...",
            "Memory system ready",
            "สวัสดีค่า โซระจัง~ 💜",
            "Live2D model loaded",
            "Gemini API connected",
        ];

        let sIndex = 0;
        let isPaused = false;
        let started = false;

        const charDelay = (ch: string) => {
            if (".…~!?".includes(ch)) return 140 + Math.random() * 60;
            if (ch === " ") return 70 + Math.random() * 30;
            return 28 + Math.random() * 22;
        };

        const typeText = (text: string, onDone: () => void) => {
            let i = 0;
            const step = () => {
                if (isPaused) { setTimeout(step, 200); return; }
                i++;
                vivianStatusText.textContent = text.slice(0, i);
                if (i >= text.length) { onDone(); return; }
                setTimeout(step, charDelay(text[i - 1]));
            };
            step();
        };

        const fadeOut = (onDone: () => void) => {
            vivianStatusText.style.transition = "opacity 0.35s ease";
            vivianStatusText.style.opacity = "0";
            setTimeout(() => {
                vivianStatusText.textContent = "";
                vivianStatusText.style.transition = "none";
                vivianStatusText.style.opacity = "1";
                onDone();
            }, 380);
        };

        const cycle = () => {
            if (isPaused) { setTimeout(cycle, 300); return; }
            sIndex = (sIndex + 1) % statuses.length;
            typeText(statuses[sIndex], () => {
                setTimeout(() => {
                    if (isPaused) { setTimeout(cycle, 300); return; }
                    fadeOut(cycle);
                }, 2600);
            });
        };

        // Pause on hover
        aiWaifuCard.addEventListener('mouseenter', () => { isPaused = true; });
        aiWaifuCard.addEventListener('mouseleave', () => { isPaused = false; });

        // Only start when the card is actually visible on screen
        const startObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting && !started) {
                    started = true;
                    startObserver.disconnect();
                    setTimeout(() => fadeOut(cycle), 3500);
                }
            });
        }, { threshold: 0.2 });

        startObserver.observe(aiWaifuCard);
    }
</script>
