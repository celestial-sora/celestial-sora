---
const projects = [
    { number: '01', type: 'AI VISUAL NOVEL', title: 'Sora Novel', description: 'Visual Novel แนว office life ที่ใช้ AI Memory และ Dynamic Storytelling ทำให้แต่ละ run มีเรื่องราวไม่เหมือนกัน', tags: ['Gemini', 'AI Memory', 'Dynamic Storytelling'], primary: 'ลองเล่นโปรเจกต์', href: 'https://sora-novel.vercel.app/', secondary: 'Source code', secondaryHref: 'https://github.com/celestial-sora/Sora-Novel' },
    { number: '02', type: 'AI COMPANION', title: 'Vivian', description: 'AI companion ภาษาไทยที่มี Live2D character, speech bubble และระบบความจำสำหรับบทสนทนา', tags: ['Live2D', 'Memory', 'TTS / STT'], primary: 'ดูโปรเจกต์บน GitHub', href: 'https://github.com/celestial-sora/ai-waifu' },
    { number: '03', type: 'OPEN SOURCE', title: 'celestial-sora', description: 'คลังแสงโค้ดและโปรเจกต์ที่ Sora สร้างไว้ ตั้งแต่ experiments เล็ก ๆ ไปจนถึงระบบที่ใช้งานจริง', tags: ['GitHub', 'Astro', 'Vibe Coding'], primary: 'เปิด GitHub', href: 'https://github.com/celestial-sora' },
];
---
<section class="section-shell projects-section" id="projects">
    <div class="section-heading section-heading--row">
        <div><span class="eyebrow">Selected work</span><h2>Things I make<br /><em>when curiosity wins.</em></h2></div>
        <p>โปรเจกต์บางส่วนที่สะท้อนความสนใจด้าน AI, story และ interface design</p>
    </div>

    <div class="project-list">
        {projects.map((project) => (
            <article class="project-row">
                <div class="project-row__number">{project.number}</div>
                <div class="project-row__body">
                    <span class="card-kicker">{project.type}</span>
                    <h3>{project.title}</h3>
                    <p>{project.description}</p>
                    <div class="tag-list">{project.tags.map((tag) => <span>{tag}</span>)}</div>
                </div>
                <div class="project-row__actions">
                    <a class="button button--primary" href={project.href} target="_blank" rel="noopener noreferrer">{project.primary} <span>↗</span></a>
                    {project.secondaryHref && <a class="button button--quiet" href={project.secondaryHref} target="_blank" rel="noopener noreferrer">{project.secondary} <span>↗</span></a>}
                </div>
            </article>
        ))}
    </div>
</section>
