                    <!-- Action Scratch Foil Button -->
                    <div class="mt-auto">
                        <div class="relative w-full max-w-[320px] max-sm:max-w-full h-[46px] max-sm:h-[44px] rounded-xl overflow-hidden select-none touch-none shadow-[0_6px_20px_rgba(0,0,0,0.35)]" id="githubScratchWrapper">
                            <!-- Hidden Revealed Secret Underneath -->
                            <a href="https://github.com/celestial-sora" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2.5 px-5 max-sm:px-3 w-full h-full bg-gradient-to-r from-[#c3b1e1] via-[#a892d6] to-[#8ec8d8] text-neutral-950 font-extrabold text-[15px] max-sm:text-[13.5px] tracking-wide no-underline rounded-xl transition-all hover:-translate-y-0.5 hover:shadow-[0_10px_25px_rgba(195,177,225,0.45)] hover:brightness-105" id="githubScratchLink">
                                <span>Let's Begin 🚀</span>
                                <span class="inline-flex w-3.5 h-3.5">
                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="5" y1="12" x2="19" y2="12"></line>
                                        <polyline points="12 5 19 12 12 19"></polyline>
                                    </svg>
                                </span>
                            </a>
                            <!-- Top Foil Cover Layer (Scratchable on Hover) -->
                            <canvas id="githubScratchCanvas" class="absolute inset-0 w-full h-full cursor-pointer z-10 rounded-xl transition-opacity duration-400"></canvas>
                        </div>
                    </div>
                </div>
            </div>

        </div>
