---
<section class="section projects-section" id="projects">
    <div class="section-container">
        <div class="section-header">
            <span class="section-tag frosted-glass">
                <span class="section-tag-icon">
                    <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor">
                        <path d="M12 2L14.85 9.15L22 12L14.85 14.85L12 22L9.15 14.85L2 12L9.15 9.15L12 2Z"></path>
                    </svg>
                </span>
                ผลงาน
            </span>
            <h2 class="section-title">My Creations</h2>
        </div>
        <div class="projects-grid">

            <!-- Sora Novel Island Card -->
            <div class="project-card frosted-glass">
                <div class="project-info">
                    <div class="project-meta">
                        <span class="project-category">
                            <span class="project-cat-icon">
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                                    <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
                                </svg>
                            </span>
                            <span>AI VISUAL NOVEL / INTERACTIVE GAME</span>
                        </span>
                        <div class="project-badges">
                            <span class="project-status-badge major-update">MAJOR UPDATE</span>
                            <span class="project-status-badge beta">AI MEMORY SYSTEM</span>
                        </div>
                    </div>
                    <h3 class="project-name">Sora Novel</h3>
                    <p class="project-desc">
                        ชื่อเกมยังคิดไม่ออกเอา sora novel ไปก่อนละกันเป็นเกมแนว NV ที่เกี่ยวกับเด็กใหม่ที่เพิ่งทำงานกับบริษัท Tech
                       <div> Main features มี AI Memory และ Dynamic Storytelling ที่จะทำให้ตัวเกมมีความหลากหลายและน่าสนใจมากขึ้น</div>
                       <div>มี sandbox mode ที่คุยได้แต่ จำกัดการใช้งาน (ถ้าอยากใช้เพิ่มจ่ายค่า token มาซ่ะ ที่ช่องโดเนท muhahaha)</div>
                    </p>
                    <div class="project-tech-tags">
                        <span class="tech-tag frosted-glass">🚀 Major Update</span>
                        <span class="tech-tag frosted-glass">Gemini 3.5 Flash</span>
                        <span class="tech-tag frosted-glass">AI Memory System</span>
                        <span class="tech-tag frosted-glass">Dynamic Storytelling</span>
                        <span class="tech-tag frosted-glass">Vanilla JS</span>
                        <span class="tech-tag frosted-glass">CSS Grid / Flexbox</span>
                    </div>
                    <div class="project-buttons">
                        <a href="https://sora-novel.vercel.app/" target="_blank" rel="noopener noreferrer" class="btn btn-primary project-btn">
                            <span>ลองเล่นดูได้แต่อาจจะ cring</span>
                            <span class="btn-arrow">
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                    <polyline points="12 5 19 12 12 19"></polyline>
                                </svg>
                            </span>
                        </a>
                        <a href="https://github.com/celestial-sora/Sora-Novel" target="_blank" rel="noopener noreferrer" class="btn btn-outline project-btn">
                            <span>เข้ามาดูวัตถุดิบของเกมนี้ได้น้าา</span>
                        </a>
                    </div>
                </div>
            </div>

            <!-- GitHub Profile Card -->
            <div class="project-card frosted-glass">
                <div class="project-info">
                    <div class="project-meta">
                        <span class="project-category">
                            <span class="project-cat-icon">
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M16 18l6-6-6-6M8 6l-6 6 6 6"></path>
                                </svg>
                            </span>
                            <span>GitHub Profile / Repositories</span>
                        </span>
                        <span class="project-status-badge beta">Active</span>
                    </div>
                    <h3 class="project-name">celestial-sora</h3>
                    <p class="project-desc">
                        คลังแสงโค้ดและโปรเจกต์ทั้งหลายที่ sora ได้สร้างเอาไว้
                    </p>
                    <div class="project-tech-tags">
                        <span class="tech-tag frosted-glass">Git Repositories</span>
                        <span class="tech-tag frosted-glass">Open Source</span>
                        <span class="tech-tag frosted-glass">Astro 7</span>
                        <span class="tech-tag frosted-glass">Vibe Coding</span>
                    </div>
                    <div class="project-buttons">
                        <!-- Scratch Coin Hover Button -->
                        <div class="scratch-btn-wrapper" id="githubScratchWrapper">
                            <!-- Hidden Revealed Secret Underneath -->
                            <a href="https://github.com/celestial-sora" target="_blank" rel="noopener noreferrer" class="scratch-underlayer-btn" id="githubScratchLink">
                                <span class="scratch-secret-text">Let's Begin 🚀</span>
                                <span class="btn-arrow">
                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="5" y1="12" x2="19" y2="12"></line>
                                        <polyline points="12 5 19 12 12 19"></polyline>
                                    </svg>
                                </span>
                            </a>
                            <!-- Top Foil Cover Layer (Scratchable on Hover) -->
                            <canvas id="githubScratchCanvas" class="scratch-top-canvas"></canvas>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<style>
.scratch-btn-wrapper {
    position: relative;
    width: 100%;
    max-width: 320px;
    height: 46px;
    border-radius: 12px;
    overflow: hidden;
    user-select: none;
    touch-action: none;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
}

.scratch-underlayer-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #c3b1e1 0%, #a892d6 50%, #8ec8d8 100%);
    color: #0c0c0d;
    font-weight: 800;
    font-size: 15px;
    letter-spacing: 0.05em;
    text-decoration: none;
    border-radius: 12px;
    transition: transform 0.25s ease, box-shadow 0.25s ease, filter 0.25s ease;
    box-sizing: border-box;
    padding: 0 20px;
}

.scratch-underlayer-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(195, 177, 225, 0.45);
    filter: brightness(1.08);
}

.scratch-top-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    cursor: pointer;
    z-index: 2;
    transition: opacity 0.4s ease;
    border-radius: 12px;
}

@media (max-width: 640px) {
    .scratch-btn-wrapper {
        max-width: 100%;
        height: 44px;
    }
    .scratch-underlayer-btn {
        font-size: 13.5px;
        padding: 0 12px;
        gap: 6px;
    }
}
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
      // Wait one frame for CSS layout to settle (fonts, flex sizing)
      requestAnimationFrame(() => {
        const canvas = document.getElementById('githubScratchCanvas') as HTMLCanvasElement | null;
        const wrapper = document.getElementById('githubScratchWrapper');

        if (!canvas || !wrapper) return;

        const ctx = canvas.getContext('2d', { willReadFrequently: true });
        if (!ctx) return;

        let rect = wrapper.getBoundingClientRect();
        let w = (canvas.width = rect.width || 320);
        let h = (canvas.height = rect.height || 46);

        let isRevealed = false;

        // Draw top foil layer showing ORIGINAL button text
        const drawFoilCover = () => {
            if (isRevealed) return;
            ctx.globalCompositeOperation = 'source-over';

            const grad = ctx.createLinearGradient(0, 0, w, h);
            grad.addColorStop(0.0, '#3a3848');
            grad.addColorStop(0.4, '#545068');
            grad.addColorStop(0.7, '#3a3848');
            grad.addColorStop(1.0, '#262432');

            ctx.fillStyle = grad;
            ctx.beginPath();
            ctx.roundRect(0, 0, w, h, 12);
            ctx.fill();

            // Metallic glitter noise
            for (let i = 0; i < 180; i++) {
                ctx.fillStyle = Math.random() > 0.5 ? 'rgba(255,255,255,0.22)' : 'rgba(195,177,225,0.2)';
                ctx.fillRect(Math.random() * w, Math.random() * h, 2, 2);
            }

            // Outer border line
            ctx.strokeStyle = 'rgba(255, 255, 255, 0.18)';
            ctx.lineWidth = 1.5;
            ctx.strokeRect(1, 1, w - 2, h - 2);

            // Responsive font size
            const fontSize = w < 340 ? '12px' : '13.5px';

            // Original text & arrow on cover layer
            ctx.fillStyle = '#ffffff';
            ctx.font = `600 ${fontSize} "IBM Plex Mono", sans-serif`;
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.shadowColor = 'rgba(0,0,0,0.6)';
            ctx.shadowBlur = 3;
            ctx.fillText('มาส่องโค้ด / project กันได้น้าา  ➔', w / 2, h / 2);
        };

        drawFoilCover();

        const updateCanvasDimensions = () => {
            if (isRevealed) return;
            rect = wrapper.getBoundingClientRect();
            if (rect.width && rect.height) {
                w = canvas.width = rect.width;
                h = canvas.height = rect.height;
                drawFoilCover();
            }
        };

        window.addEventListener('resize', updateCanvasDimensions, { passive: true });

        const scratchAt = (x: number, y: number) => {
            if (isRevealed) return;

            ctx.globalCompositeOperation = 'destination-out';
            ctx.beginPath();
            ctx.arc(x, y, 22, 0, Math.PI * 2);
            ctx.fill();

            checkRevealed();
        };

        const getCanvasCoords = (e: MouseEvent | TouchEvent) => {
            const r = canvas.getBoundingClientRect();
            let clientX: number, clientY: number;
            if ('touches' in e && e.touches.length > 0) {
                clientX = e.touches[0].clientX;
                clientY = e.touches[0].clientY;
            } else if ('changedTouches' in e && e.changedTouches.length > 0) {
                clientX = e.changedTouches[0].clientX;
                clientY = e.changedTouches[0].clientY;
            } else {
                clientX = (e as MouseEvent).clientX;
                clientY = (e as MouseEvent).clientY;
            }
            return { x: clientX - r.left, y: clientY - r.top };
        };

        const checkRevealed = () => {
            if (isRevealed) return;

            const imgData = ctx.getImageData(0, 0, w, h);
            const pixels = imgData.data;
            let clearCount = 0;

            for (let i = 3; i < pixels.length; i += 16) {
                if (pixels[i] === 0) clearCount++;
            }

            const percent = (clearCount / (pixels.length / 16)) * 100;

            // Must scratch off almost completely (78%+) before clearing remaining foil!
            if (percent > 78) {
                isRevealed = true;
                canvas.style.opacity = '0';
                setTimeout(() => {
                    canvas.style.display = 'none';
                }, 400);
            }
        };

        // Mouse hover scratch
        canvas.addEventListener('mousemove', (e) => {
            const pos = getCanvasCoords(e);
            scratchAt(pos.x, pos.y);
        });

        canvas.addEventListener('mouseenter', (e) => {
            const pos = getCanvasCoords(e);
            scratchAt(pos.x, pos.y);
        });

        // Mobile touch scratch
        canvas.addEventListener('touchstart', (e) => {
            const pos = getCanvasCoords(e);
            scratchAt(pos.x, pos.y);
        }, { passive: true });

        canvas.addEventListener('touchmove', (e) => {
            const pos = getCanvasCoords(e);
            scratchAt(pos.x, pos.y);
        }, { passive: true });

        canvas.addEventListener('click', (e) => {
            const pos = getCanvasCoords(e);
            scratchAt(pos.x, pos.y);
            window.open('https://github.com/celestial-sora', '_blank');
        });
      }); // end requestAnimationFrame
    });
</script>
