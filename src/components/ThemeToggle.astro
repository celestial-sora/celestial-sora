<button class="theme-toggle" id="themeToggle" type="button" aria-label="Toggle theme"><svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="3" /><path d="M8 1v2M8 13v2M1 8h2M13 8h2M3 3l1.4 1.4M11.6 11.6 13 13M13 3l-1.4 1.4M4.4 11.6 3 13" /></svg><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M12.5 10.8A5.4 5.4 0 0 1 5.2 3.5 5.5 5.5 0 1 0 12.5 10.8Z" /></svg></button>
<script>
    const themeToggle = document.getElementById('themeToggle');
    themeToggle?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('sora-theme', next);
    });
</script>
