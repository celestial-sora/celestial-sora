---
const socials = [
    { name: 'Instagram', handle: '@sphle_sora', href: 'https://www.instagram.com/sphle_sora/', icon: 'instagram' },
    { name: 'TikTok', handle: 'Sorachan', href: 'https://www.tiktok.com/@celestialsora.vercel.app', icon: 'tiktok' },
    { name: 'YouTube', handle: 'Sora Astralis', href: 'https://www.youtube.com/@sorachanXZ-d1r', icon: 'youtube' },
    { name: 'Discord', handle: 'Direct message', href: 'https://discord.com/users/1433232573202698302', icon: 'discord' },
    { name: 'Telegram', handle: 't.me/sorastra', href: 'https://t.me/sorastra', icon: 'telegram' },
    { name: 'Roblox', handle: 'Sora Astralis', href: 'https://www.roblox.com/share?code=bd0b2fd6ff7ddd4f820d9ed51929aa1a&type=Profile&source=ProfileShare&stamp=1789968912882', icon: 'roblox' },
];
---
<section class="section-shell social-section" id="social">
    <div class="section-heading">
        <span class="eyebrow">Stay in touch</span>
        <h2>Let’s keep in touch<br /><em>and see what comes next.</em></h2>
    </div>

    <div class="support-panel material-card">
        <div><span class="card-kicker">SUPPORT THE WORK</span><h3>Help the next idea take shape.</h3><p>If you enjoy what Sora makes, you can support the work through the links below.</p></div>
        <div class="support-panel__actions">
            <a class="button button--primary" href="https://happydonate.app/sora" target="_blank" rel="noopener noreferrer"><img src={import.meta.env.BASE_URL + "happydonate-logo.png"} alt="" />Happy Donate <svg class="icon-inline" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 13 13 3M5 3h8v8" /></svg></a>
            <a class="button button--quiet" href="https://easydonate.app/sorapurr" target="_blank" rel="noopener noreferrer"><img src={import.meta.env.BASE_URL + "easydonate-logo.ico"} alt="" />EasyDonate <svg class="icon-inline" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 13 13 3M5 3h8v8" /></svg></a>
        </div>
    </div>

    <div class="social-grid">
        {socials.map((social) => (
            <a class="social-link material-card" href={social.href} target="_blank" rel="noopener noreferrer">
                <span class={`social-link__icon social-link__icon--${social.icon}`} aria-hidden="true">
                    {social.icon === 'instagram' && <svg viewBox="0 0 24 24"><rect x="3.5" y="3.5" width="17" height="17" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.6" cy="6.6" r="1" class="social-link__icon-dot" /></svg>}
                    {social.icon === 'tiktok' && <svg viewBox="0 0 24 24"><path d="M14 4v10.2a4.2 4.2 0 1 1-3.2-4.08" /><path d="M14 4c.6 2.7 2.3 4.3 5 4.7" /></svg>}
                    {social.icon === 'youtube' && <svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="12" rx="4" /><path d="m10 9 5 3-5 3Z" fill="currentColor" stroke="none" /></svg>}
                    {social.icon === 'discord' && <svg viewBox="0 0 24 24"><path d="M7.2 7.3a13.1 13.1 0 0 1 9.6 0 12.5 12.5 0 0 1 2.2 8.8 10.6 10.6 0 0 1-3.4 1.7l-.8-1.2a6.9 6.9 0 0 0 1.8-.9 7.2 7.2 0 0 1-1.1.5 8.6 8.6 0 0 1-7 0 7.2 7.2 0 0 1-1.1-.5 6.9 6.9 0 0 0 1.8.9l-.8 1.2a10.6 10.6 0 0 1-3.4-1.7 12.5 12.5 0 0 1 2.2-8.8Z" /><circle cx="9.2" cy="12.2" r="1.2" fill="currentColor" stroke="none" /><circle cx="14.8" cy="12.2" r="1.2" fill="currentColor" stroke="none" /></svg>}
                    {social.icon === 'telegram' && <svg viewBox="0 0 24 24"><path d="m20.5 4.5-3.1 15-5.8-4.3-3.3 2.9.7-4.7L19 6.1 9.7 12l-5.2-1.7Z" /><path d="m11.6 15.2 1.1-3.2" /></svg>}
                    {social.icon === 'roblox' && <svg viewBox="0 0 24 24"><path d="m6.6 4.6 12.8 3.2-3.2 12.8-12.8-3.2Z" /><path d="m11.1 10.6 3.1.8-.8 3.1-3.1-.8Z" fill="currentColor" stroke="none" /></svg>}
                </span><span><strong>{social.name}</strong><small>{social.handle}</small></span><svg class="social-link__arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 13 13 3M5 3h8v8" /></svg>
            </a>
        ))}
    </div>
</section>