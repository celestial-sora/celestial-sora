---
const socials = [
    { name: 'Instagram', handle: '@sphle_sora', href: 'https://www.instagram.com/sphle_sora/' },
    { name: 'TikTok', handle: 'Sorachan', href: 'https://www.tiktok.com/@celestialsora.vercel.app' },
    { name: 'YouTube', handle: 'Sora Astralis', href: 'https://www.youtube.com/@sorachanXZ-d1r' },
    { name: 'Discord', handle: 'Direct message', href: 'https://discord.com/users/1433232573202698302' },
];
---
<section class="section-shell social-section" id="social">
    <div class="section-heading">
        <span class="eyebrow">Stay in touch</span>
        <h2>มาคุยกันได้<br /><em>ถ้าอยากรู้ว่ากำลังสร้างอะไรอยู่</em></h2>
    </div>

    <div class="support-panel material-card">
        <div><span class="card-kicker">SUPPORT THE WORK</span><h3>ช่วยเติมพลังให้โปรเจกต์ต่อไป</h3><p>ถ้าชอบสิ่งที่ Sora สร้าง สามารถสนับสนุนผ่านช่องทางด้านล่างได้เลย</p></div>
        <div class="support-panel__actions">
            <a class="button button--primary" href="https://happydonate.app/sora" target="_blank" rel="noopener noreferrer"><img src={import.meta.env.BASE_URL + "happydonate-logo.png"} alt="" />Happy Donate ↗</a>
            <a class="button button--quiet" href="https://easydonate.app/sorapurr" target="_blank" rel="noopener noreferrer"><img src={import.meta.env.BASE_URL + "easydonate-logo.ico"} alt="" />EasyDonate ↗</a>
        </div>
    </div>

    <div class="social-grid">
        {socials.map((social, index) => (
            <a class="social-link material-card" href={social.href} target="_blank" rel="noopener noreferrer">
                <span class="social-link__index">0{index + 1}</span><span><strong>{social.name}</strong><small>{social.handle}</small></span><span class="social-link__arrow">↗</span>
            </a>
        ))}
    </div>
</section>
