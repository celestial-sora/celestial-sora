---
---
<section class="relative py-24 px-6 md:px-10 max-w-full overflow-hidden" id="about">
    <div class="max-w-[1100px] mx-auto">
        <!-- Section Header -->
        <div class="section-header text-center mb-12 sm:mb-14 reveal">
            <span class="frosted-glass inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-semibold text-[var(--accent-primary)] mb-4">
                <span class="inline-flex w-3 h-3">
                    <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor">
                        <path d="M12 2L14.85 9.15L22 12L14.85 14.85L12 22L9.15 14.85L2 12L9.15 9.15L12 2Z"></path>
                    </svg>
                </span>
                เกี่ยวกับเว็บไซต์
            </span>
            <h2 class="text-3xl md:text-5xl font-extrabold tracking-tight text-[var(--text-primary)] font-heading">
                ทำไมถึงมีเว็บนี้กันน้าา?
            </h2>
        </div>

        <!-- About Content Card -->
        <div class="max-w-[780px] mx-auto">
            <div class="about-text-card frosted-glass p-7 sm:p-10 rounded-3xl transition-all duration-300 hover:scale-[1.015] hover:shadow-[0_25px_65px_rgba(0,0,0,0.55),0_0_40px_rgba(195,177,225,0.35)] reveal">
                <h3 
                    class="text-xl sm:text-2xl font-bold mb-5 text-[var(--text-primary)] font-heading cursor-pointer select-none inline-block transition-transform duration-200 hover:scale-[1.02] active:scale-95" 
                    id="easterEggTitle" 
                    role="button" 
                    tabindex="0" 
                    title="ลองคลิกดูสิ!"
                >
                    <span class="text-original">
                        <span>มีเพื่อเป็นศูนย์รวม </span>
                        <span class="text-[var(--accent-primary)] font-bold">Web Portal</span>
                        <span> & Hub</span>
                    </span>
                    <span class="text-secret hidden">
                        <span>เจ้าของเว้บเป็น </span>
                        <span class="text-[var(--accent-primary)] font-bold">Femboy</span>
                    </span>
                </h3>

                <p class="text-sm sm:text-[15px] leading-relaxed text-[var(--text-secondary)] mb-4">
                    เว็บนี้สร้างไว้เป็น <strong class="text-[var(--text-primary)] font-bold">Web Portal</strong> รวมวาร์ปไปเว็บ แอป โปรเจกต์ต่างๆ ของโซระจัง (และไว้ส่งงานครูเอสด้วยนะ )
                </p>
                <p class="text-sm sm:text-[15px] leading-relaxed text-[var(--text-secondary)] mb-6">
                    เชื่อมครบทั้ง <strong class="text-[var(--text-primary)] font-bold">Social Media</strong> และ <strong class="text-[var(--text-primary)] font-bold">GitHub</strong> แวะมาดูผลงานหรือเข้าถึงแอปได้จบในที่เดียว รึป่าว (อาจจะมีการส่งงานครูคนอื่นด้วยลิ้งนี้ ฮิฮิ)
                </p>

                <!-- Stats Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mt-7">
                    <div class="flex items-center gap-3 p-3.5 bg-[var(--bg-secondary)] rounded-xl border border-[var(--border-color)] hover:border-[var(--border-hover)] hover:-translate-y-0.5 transition-all">
                        <span class="inline-flex items-center justify-center w-6 h-6 text-[var(--accent-primary)]">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="2" y1="12" x2="22" y2="12"></line>
                                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                            </svg>
                        </span>
                        <div class="flex flex-col">
                            <span class="text-[10px] sm:text-[11px] font-semibold text-[var(--text-muted)] uppercase tracking-wider">Web & Apps</span>
                            <span class="text-xs sm:text-[13px] font-bold text-[var(--text-primary)]">Central Hub</span>
                        </div>
                    </div>

                    <div class="flex items-center gap-3 p-3.5 bg-[var(--bg-secondary)] rounded-xl border border-[var(--border-color)] hover:border-[var(--border-hover)] hover:-translate-y-0.5 transition-all">
                        <span class="inline-flex items-center justify-center w-6 h-6 text-[var(--accent-primary)]">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="18" cy="5" r="3"></circle>
                                <circle cx="6" cy="12" r="3"></circle>
                                <circle cx="18" cy="19" r="3"></circle>
                                <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                                <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                            </svg>
                        </span>
                        <div class="flex flex-col">
                            <span class="text-[10px] sm:text-[11px] font-semibold text-[var(--text-muted)] uppercase tracking-wider">Social Media</span>
                            <span class="text-xs sm:text-[13px] font-bold text-[var(--text-primary)]">N/A</span>
                        </div>
                    </div>

                    <div class="flex items-center gap-3 p-3.5 bg-[var(--bg-secondary)] rounded-xl border border-[var(--border-color)] hover:border-[var(--border-hover)] hover:-translate-y-0.5 transition-all">
                        <span class="inline-flex items-center justify-center w-6 h-6 text-[var(--accent-primary)]">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
                            </svg>
                        </span>
                        <div class="flex flex-col">
                            <span class="text-[10px] sm:text-[11px] font-semibold text-[var(--text-muted)] uppercase tracking-wider">GitHub</span>
                            <span class="text-xs sm:text-[13px] font-bold text-[var(--text-primary)]">Source Code</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    const easterEgg = document.getElementById('easterEggTitle');
    if (easterEgg) {
        const originalText = easterEgg.querySelector('.text-original');
        const secretText = easterEgg.querySelector('.text-secret');

        const toggleEasterEgg = () => {
            if (originalText && secretText) {
                originalText.classList.toggle('hidden');
                secretText.classList.toggle('hidden');
            }
        };

        easterEgg.addEventListener('click', toggleEasterEgg);
        easterEgg.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                toggleEasterEgg();
            }
        });
    }
</script>
