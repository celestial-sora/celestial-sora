---
---
<footer class="py-10 px-6 border-t border-[var(--border-color)] text-center">
    <div class="flex flex-col items-center">
        <!-- Footer Logo -->
        <div class="flex items-center justify-center gap-2.5 mb-3">
            <span class="inline-flex w-4.5 h-4.5 text-[var(--accent-primary)]">
                <img src={import.meta.env.BASE_URL + "sora-logo.png"} alt="Sora Logo" class="w-4.5 h-4.5 object-contain drop-shadow-[0_0_5px_rgba(195,177,225,0.4)]" />
            </span>
            <span class="text-base font-extrabold tracking-[2px] text-[var(--text-primary)] font-heading">SORA ASTRALIS</span>
        </div>
        <!-- Footer Info -->
        <p class="text-sm text-[var(--text-secondary)] mb-2 flex items-center justify-center gap-1.5">
            <span>Made with</span>
            <span class="inline-flex w-3.5 h-3.5 text-[var(--accent-primary)]">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
                    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"></path>
                </svg>
            </span>
            <span>by Sora Astralis</span>
        </p>
        <p class="text-xs text-[var(--text-muted)]">© 2026 Sora Astralis. สงวนลิขสิทธิ์</p>
    </div>
</footer>
