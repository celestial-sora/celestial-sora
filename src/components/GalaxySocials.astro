---
import { socials } from "../galaxy/socials.js";
---

<div class="galaxy-socials" aria-label="Sora’s social accounts">
  <p class="social-heading">little places you can find me ੈ♡</p>
  <div class="social-constellation">
    {socials.map((social) => (
      <a
        href={social.href}
        target="_blank"
        rel="noopener noreferrer"
        class="social-orbit"
      >
        <img src={`/icons/${social.icon}.svg`} width="18" height="18" alt="" />
        <span>
          <strong>{social.name}</strong>
          <small>{social.handle}</small>
        </span>
        <svg
          class="arrow-icon"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
        >
          <path d="M3 13 13 3M3 3h10v10" />
        </svg>
      </a>
    ))}
  </div>
</div>
