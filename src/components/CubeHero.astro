---
---
<section class="hero-static relative w-full min-h-screen overflow-hidden" id="home">
    <div class="hero-static__wash absolute inset-0 pointer-events-none" aria-hidden="true"></div>

    <div class="relative z-10 min-h-screen flex flex-col justify-between pt-28 pb-8 px-6 sm:px-10">
        <div class="flex justify-between items-center w-full">
            <span class="font-mono text-[clamp(0.68rem,1.1vw,0.82rem)] tracking-[0.14em] uppercase text-[var(--text-muted)]">
                Creator &amp; Vibe Coder
            </span>
            <span class="hidden sm:inline font-mono text-[clamp(0.68rem,1.1vw,0.82rem)] tracking-[0.14em] uppercase text-[var(--text-muted)]">
                Sora Astralis © 2026
            </span>
        </div>

        <div class="flex-1 flex items-center justify-center py-12 sm:py-16">
            <div class="hero-profile-card frosted-glass flex flex-col items-center p-4 sm:p-6 w-[min(94vw,470px)] bg-[var(--glass-beige)] border border-[var(--glass-border)] rounded-[30px] shadow-[0_24px_70px_var(--glass-shadow)]">
                <div class="w-full flex items-center justify-between px-1 mb-4">
                    <span class="font-mono text-[10px] sm:text-[11px] font-semibold tracking-[0.24em] uppercase text-[var(--text-muted)]">
                        SORA CHARACTER
                    </span>
                    <span class="inline-flex items-center gap-1.5 text-[10px] font-mono tracking-wider text-[var(--accent-pink)] uppercase">
                        <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-pink)]"></span>
                        Online
                    </span>
                </div>

                <div class="w-full rounded-[22px] overflow-hidden border border-[var(--image-border)] bg-[var(--image-surface)]">
                    <img
                        src={import.meta.env.BASE_URL + "sora-profile.jpg"}
                        alt="Sora Character"
                        class="w-full h-auto max-h-[68svh] object-contain block"
                    />
                </div>

                <div class="flex justify-between items-center w-full px-1 pt-4 font-sans text-sm">
                    <div class="font-mono font-extrabold tracking-[0.16em] text-sm sm:text-[15px] text-[var(--text-primary)]">
                        SORA
                    </div>

                    <a href="#about" class="flex flex-col items-center no-underline text-[var(--accent-pink)] hover:text-[var(--accent-blue)] transition-colors" aria-label="Scroll down">
                        <span class="text-[11px] sm:text-[13px] font-medium tracking-wide">เลื่อนลงโลดดดด</span>
                        <span class="text-sm font-bold -mt-0.5">↓</span>
                    </a>

                    <div class="flex items-center gap-1 text-xs sm:text-sm font-medium text-[var(--accent-blue)]">
                        <span class="text-xs">✦</span>
                        <span>Astralis</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex justify-between items-center w-full">
            <span class="font-mono text-[clamp(0.58rem,1vw,0.72rem)] tracking-wider uppercase text-[var(--text-muted)]">
                GMT+7 TH
            </span>
            <span class="hidden sm:inline font-mono text-[clamp(0.58rem,1vw,0.72rem)] tracking-wider uppercase text-[var(--text-muted)]">
                Silver / Cyan / Pink
            </span>
        </div>
    </div>
</section>
